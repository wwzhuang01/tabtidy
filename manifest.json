{
  "manifest_version": 3,
  "name": "TabTidy",
  "version": "1.0.0",
  "description": "在侧边栏按窗口和分组管理标签页，去重、休眠并找回关闭的页面。",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "sidePanel"],
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TabTidy — 标签页管理",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+E", "mac": "Command+Shift+E" }
    }
  }
}
